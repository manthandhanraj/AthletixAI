# ── AthletixAI environment configuration ────────────────────────────────
# Copy this file to  .env  and fill it in.  .env is gitignored — never
# commit real values. Everything here is read at startup by app.py.

# ════════════════════════════════════════════════════════════════════════
# SESSIONS  (required in production)
# ════════════════════════════════════════════════════════════════════════
# Signs the session cookie. In production a missing/short value is a FATAL
# startup error: without it every gunicorn worker would sign cookies with a
# different random key. Generate one with:
#     python -c "import secrets;print(secrets.token_hex(32))"
# Locally you can leave it blank — a key is generated into .dev_secret_key
# (also gitignored) so sessions survive a restart.
SECRET_KEY=

# ════════════════════════════════════════════════════════════════════════
# ENVIRONMENT
# ════════════════════════════════════════════════════════════════════════
# FLASK_DEBUG=1  -> Werkzeug debugger ON. Local development ONLY: the
#                   debugger allows remote code execution.
# FLASK_DEBUG=0  -> explicit production posture: Secure cookies, HSTS, and
#                   fail-fast configuration checks.
# unset          -> plain local run: no debugger, no HTTPS-only cookies.
FLASK_DEBUG=

# Alternative production signal (same effect as FLASK_DEBUG=0).
# APP_ENV=production

# Set only when running behind a reverse proxy you control. It makes the app
# trust X-Forwarded-For for rate limiting; on a direct deployment that header
# is attacker-controlled and would let anyone reset their own rate limits.
# TRUST_PROXY=1

# ════════════════════════════════════════════════════════════════════════
# OWNER (platform admin) ACCOUNT
# ════════════════════════════════════════════════════════════════════════
# The owner is provisioned from the environment and can NEVER be created
# through public signup. If OWNER_PASSWORD is unset, no owner account exists
# at all — a safe default. It must satisfy the password policy (8+ chars,
# not a common password) or the account is refused, loudly, at startup.
#
# WARNING: changing OWNER_EMAIL deletes the previous owner account and, via
# ON DELETE CASCADE, any data owned by it. The app prints a warning when
# this happens.
OWNER_EMAIL=owner@yourdomain.com
OWNER_PASSWORD=

# ════════════════════════════════════════════════════════════════════════
# EMAIL  (verification codes + password resets)
# ════════════════════════════════════════════════════════════════════════
# With no SMTP_HOST the app runs in EMAIL DEV MODE: codes are printed to the
# console and returned in API responses. That is a development convenience
# and is force-disabled in production — but it also means that WITHOUT SMTP
# configured, production users cannot verify their email or reset a password.
# Gmail: Google Account → Security → 2-Step Verification → App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=AthletixAI <youremail@gmail.com>

# ════════════════════════════════════════════════════════════════════════
# DATABASE
# ════════════════════════════════════════════════════════════════════════
# Point this at a persistent disk in production (e.g. Render: /var/data/...)
# so the database survives restarts and redeploys.
# DB_PATH=/var/data/athletixai.db

# A full connection URL. SQLite is what this build implements; a postgres://
# URL is RECOGNISED and REFUSED at startup with an explicit message rather
# than silently falling back to a local file nobody backs up. The audit and
# migration plan are in POSTGRESQL_READINESS.md.
# DATABASE_URL=postgresql://user:password@host:5432/athletixai

# ════════════════════════════════════════════════════════════════════════
# BACKGROUND JOBS
# ════════════════════════════════════════════════════════════════════════
# Where slow work (transactional e-mail) runs, so a request handler never
# waits on SMTP. Empty = decide from the mail configuration: inline when no
# SMTP host is set (sending is a console print), background worker threads
# when one is.
#
# LIMITATION: the queue is in-process and NOT durable. A deploy or a crash
# loses whatever had not been sent; there is no retry and no dead-letter
# queue. A saturated queue refuses work rather than growing, so /auth/forgot
# reports a real failure instead of promising a code that will not arrive.
# JOB_BACKEND=background
# JOB_WORKERS=2
# JOB_QUEUE_SIZE=256

# ════════════════════════════════════════════════════════════════════════
# SCORING
# ════════════════════════════════════════════════════════════════════════
# Which implementation athletix/scoring/ uses. Only "client-submitted"
# exists: the AI/CV pipeline runs in the browser, so submitted scores are
# untrusted and every report records that. An unknown name is a hard error.
# SCORING_PROVIDER=client-submitted

# ════════════════════════════════════════════════════════════════════════
# OPTIONAL / DEVELOPMENT
# ════════════════════════════════════════════════════════════════════════
# Seed the demo roster. Defaults to on locally, off in production, and is a
# FATAL error if forced on in production (the accounts share a known password).
# SEED_DEMO=1
# SEED_PASSWORD=AthletixDemo!2026

# bcrypt work factor. Defaults to 12 and is clamped to >= 12 whenever a
# production signal is present, so it cannot be used to weaken a deployment.
# The test suite sets it to 4 for speed.
# BCRYPT_ROUNDS=12

# Ship the Content-Security-Policy in report-only mode (troubleshooting only).
# CSP_REPORT_ONLY=1

# Force Secure cookies even outside production (e.g. behind a local HTTPS proxy).
# COOKIE_SECURE=1
