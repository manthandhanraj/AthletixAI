# ── Rename this file to  .env  and fill in to send REAL emails ──
# Easiest: Gmail with an App Password (Google Account → Security → 2-Step → App passwords)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=AthletixAI <youremail@gmail.com>

# A strong random secret for sessions (change this before launch):
SECRET_KEY=change-this-to-a-long-random-string
